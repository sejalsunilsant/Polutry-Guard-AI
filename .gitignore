# =============================================================================
# PoultryGuard AI - Git Ignore Configuration
# =============================================================================

# --- Environment Secrets & Credentials (NEVER COMMIT) ---
.env
.env.*
!.env.example
*.env
local.properties
**/local.properties
*.pem
*.key
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
serviceAccountKey.json
firebase_credentials.json

# --- Python Environments & Caches ---
.venv/
venv/
env/
ENV/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.log

# --- Android Build Outputs & Intermediate Files ---
**/build/
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
PoultryGuardAndroid/.idea_backup/
PoultryGuardAndroid/.gradle/
PoultryGuardAndroid/.kotlin/
PoultryGuardAndroid/**/build/
*.dex
*.class

# --- IDE Settings & Editor Configs ---
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Large Datasets & Binary Training Archives ---
*.zip
*.tar.gz
*.xlsx
ML_Models/poultry_cnn_model.h5
*.bin
*.exe

# --- OS Specific Files ---
.DS_Store
Thumbs.db
desktop.ini
*.pb
*.ckpt
.json

# Keep required backend machine learning models and class mappings
!farm_ai_backend/ml/model/*
!farm_ai_backend/Apurva_Model/*.json
!farm_ai_backend/Apurva_Model/*.pth
!farm_ai_backend/Apurva_Model/*.pkl
!farm_ai_backend/ML_Models/*

farm_ai_backend/Apurva_Model/class_mapping.json
farm_ai_backend/ml/model/disease_classes.json
farm_ai_backend/ml/model/disease_xgb_classes.json
farm_ai_backend/ml/model/disease_xgb_model.json
farm_ai_backend/ml/model/sound_classes.json
farm_ai_backend/ml/model/sound_xgb_model.json
farm_ai_backend/ml/model/xgboost_model.json
.gitignore
farm_ai_backend/ML_Models/disease_xgb_model.json
farm_ai_backend/ML_Models/disease_classes.json
farm_ai_backend/ML_Models/sound_classes.json
farm_ai_backend/ML_Models/sound_xgb_model.json
